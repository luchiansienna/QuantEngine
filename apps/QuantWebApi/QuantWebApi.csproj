<Project Sdk="Microsoft.NET.Sdk.Web">

	<Import
	  Project="QuantWebApi.local.props"
	  Condition="Exists('QuantWebApi.local.props')" />

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- CI or command-line environment-variable fallback -->
		<IbkrApiPath Condition="'$(IbkrApiPath)' == ''">
			$(IBKR_API_PATH)
		</IbkrApiPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(IbkrApiPath)' != ''">
		<Reference Include="CSharpAPI">
			<HintPath>$(IbkrApiPath)</HintPath>
			<Private>true</Private>
			<SpecificVersion>false</SpecificVersion>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference
		  Include="Google.Protobuf"
		  Version="3.29.5" />
	</ItemGroup>

	<Target
	  Name="ValidateIbkrApi"
	  BeforeTargets="ResolveReferences">

		<Error
		  Condition="'$(IbkrApiPath)' == ''"
		  Text="IBKR API path is not configured. Create QuantWebApi.local.props or set IBKR_API_PATH." />

		<Error
		  Condition="'$(IbkrApiPath)' != '' and !Exists('$(IbkrApiPath)')"
		  Text="IBKR CSharpAPI.dll was not found at: $(IbkrApiPath)" />
	</Target>

</Project>